# ==============================================================================
# Egle11 Admin Console - Secure Environment Configuration
# NEVER COMMIT REAL KEYS OR SERVICE ACCOUNTS TO SOURCE CONTROL!
# ==============================================================================

# Port for local admin workspace server
PORT=3001

# Firebase Project Configuration
FIREBASE_PROJECT_ID=egle11

# Path to Firebase Admin Service Account JSON File (Server-Side ONLY)
# Download from Firebase Console -> Project Settings -> Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Master Admin Bootstrap Secret (Used only to provision the first super admin)
ADMIN_BOOTSTRAP_SECRET=EGLE11_BOOTSTRAP_MASTER_KEY_2026

# Session Security Secret
ADMIN_SESSION_SECRET=egle11_admin_session_jwt_super_secure_key_2026
